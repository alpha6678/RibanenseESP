CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb_two_ota.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# GitHub manda records TLS de ate 16 KB. 4096 gera -0x7200 (INVALID_RECORD)
# no handshake (certificado ate verifica, mas a conexao cai).
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
# So mandamos GET curto; 2048 chega e sobra heap para o record de entrada.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# Desligado de proposito. O buffer dinamico devolve o bloco de 16 KB entre
# records e o reconquista na leitura seguinte: num download de 1,4 MB isso e
# uma aposta por record, centenas de vezes, com a heap ja fragmentada.
# Desligado, o bloco e reservado uma unica vez no handshake e fica ate o fim.
# O ganho do buffer dinamico e para muitas conexoes curtas, nao para uma longa.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
# Ninguem le o certificado do par depois do handshake; guarda-lo custa ~4 KB.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Sem LFN o FAT 8.3 recusa settings.json.tmp / networks.json.tmp (dois pontos):
# fopen falha, a UI mostra "falha ao gravar" e o monitor nao mostra nada.
CONFIG_FATFS_LFN_HEAP=y

# LVGL 9 (component registry) — tema simples, 3 FPS, sem lastro
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_COLOR_DEPTH_16=y
# 333 ms davam 3 FPS: o toque era lido a cada 20 ms, mas a tecla pressionada
# so aparecia no proximo quadro — um toque rapido terminava antes de qualquer
# quadro mostrar o feedback. O LVGL so redesenha area invalidada, entao tela
# parada a 30 Hz nao custa mais que a 3 Hz.
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_USE_THEME_SIMPLE=y
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_TEXTAREA=y
# No LVGL 9 o simbolo e BUTTONMATRIX; BTNMATRIX era do LVGL 8 e virava
# "unknown kconfig symbol" silencioso no build.
CONFIG_LV_USE_BUTTONMATRIX=y
CONFIG_LV_USE_SWITCH=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_CHECKBOX=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_BUTTON=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_SNAPSHOT=n
CONFIG_LV_USE_MONKEY=n
CONFIG_LV_USE_GRIDNAV=n
CONFIG_LV_USE_IMGFONT=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
